{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "초대장 서버 실행 (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "초대장:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
