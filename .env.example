# Supabase 연결 (비워두면 data/ 폴더의 로컬 파일에 저장)
# Supabase 대시보드 → Project Settings → API 에서 복사
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_...) 또는 예전 service_role 키. 절대 프론트엔드/깃에 올리지 말 것
SUPABASE_SECRET_KEY=

# 키 예시 (실제 값은 .env 에만)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app

# 매일 편지 예약(pg_cron) 호출용 · 배포 안내(GitHub Actions)용 비밀값 (아무 긴 랜덤 문자열)
CRON_SECRET=
ADMIN_TOKEN=

# Google Gemini 무료 키 (레시피 채팅 · 편지 문장) — aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Pixabay 무료 키 (레시피 자동 일러스트) — pixabay.com/api/docs 에서 가입하면 바로 보임
PIXABAY_API_KEY=

# (선택) Pexels 무료 키 (Pixabay에서 못 찾을 때 사진) — pexels.com/api
PEXELS_API_KEY=

# 기상청 단기예보 인증키 (공공데이터포털 일반 인증키 Decoding) — 없으면 Open-Meteo 로 대신
KMA_API_KEY=

# 우리 동네 공동현관(4자리) · 도어락(6자리) 번호
TOWN_LOBBY_CODE=1234
TOWN_DOOR_CODE=123456
